# Copie para `.env.local` e preencha com o projeto Supabase NOVO (não usar o do CRM).
# A anon key é pública (vai para o browser). A service role NUNCA pode ter prefixo
# NEXT_PUBLIC_ e só deve existir no servidor/scripts locais.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uso exclusivo em scripts administrativos locais (migrations/seed).
# Não é lida pelo app em runtime.
SUPABASE_SERVICE_ROLE_KEY=
